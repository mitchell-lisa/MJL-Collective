{
  "git": {
    "deploymentEnabled": true
  },
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/clients",
      "destination": "https://mjl-client-portal.vercel.app/clients"
    },
    {
      "source": "/clients/:path*",
      "destination": "https://mjl-client-portal.vercel.app/clients/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/terms-of-service",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/terms-of-use",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy",
      "permanent": true
    }
  ]
}
