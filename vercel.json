{
  "git": {
    "deploymentEnabled": true
  },
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/clients",
      "has": [
        {
          "type": "host",
          "value": "^mjl-collective-[a-z0-9-]+-mitchell-lisas-projects\\.vercel\\.app$"
        }
      ],
      "destination": "https://mjl-client-portal-git-redesign-s-dae1cb-mitchell-lisas-projects.vercel.app/clients",
      "permanent": false
    },
    {
      "source": "/clients/:path*",
      "has": [
        {
          "type": "host",
          "value": "^mjl-collective-[a-z0-9-]+-mitchell-lisas-projects\\.vercel\\.app$"
        }
      ],
      "destination": "https://mjl-client-portal-git-redesign-s-dae1cb-mitchell-lisas-projects.vercel.app/clients/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/clients",
      "destination": "https://mjl-client-portal.vercel.app/clients"
    },
    {
      "source": "/clients/:path*",
      "destination": "https://mjl-client-portal.vercel.app/clients/:path*"
    }
  ],
  "headers": [
    {
      "source": "/compliance/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
